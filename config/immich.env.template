# ==============================================================================
# Immich Environment Configuration for Low-End SBC (ODROID-C2 / Amlogic S905)
# Optimized for: 2GB RAM / 4-Core A53 / DietPi & Debian ARM64
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Paths & Directories
# ------------------------------------------------------------------------------
# Lokasi penyimpanan foto/video asli yang diunggah
UPLOAD_LOCATION=/mnt/dietpi_userdata/immich_data

# Lokasi file database PostgreSQL
DB_DATA_LOCATION=/mnt/dietpi_userdata/immich_db

# ------------------------------------------------------------------------------
# 2. Application & Database Credentials
# ------------------------------------------------------------------------------
IMMICH_VERSION=release
DB_PASSWORD=immich_odroid_secure_pass_123
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# ------------------------------------------------------------------------------
# 3. Low-End Hardware Optimizations (Odroid-C2 2GB RAM Guard)
# ------------------------------------------------------------------------------
# Matikan Machine Learning sepenuhnya untuk mencegah OOM Kernel Panic & Freeze
IMMICH_MACHINE_LEARNING_ENABLED=false

# Batasi jumlah thread worker pemrosesan thumbnail & metadata ke 1 (Sequential)
IMMICH_CONCURRENCY=1

# Log level (info / warn / error / verbose)
IMMICH_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 4. Media & Transcoding Tunings (HEIC / RAW / H.265 / MOV)
# ------------------------------------------------------------------------------
# Prioritaskan direct streaming pada client tanpa on-the-fly transcoding
IMMICH_SERVER_PREFER_DIRECT_STREAM=true

# Preset encoding libx264/libx265 jika transcode diperlukan (ultrafast untuk SBC)
FFMPEG_PRESET=ultrafast
FFMPEG_CRF=28
FFMPEG_THREADS=2
